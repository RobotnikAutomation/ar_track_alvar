<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ar_track_alvar</name>
  <version>1.1.0</version>

  <description>
    This package is a ROS wrapper for Alvar, an open source AR tag tracking library.
  </description>

  <maintainer email="rmartin@robotnik.es">Rafael Martin</maintainer>
  <license>LGPL-2.1</license>

  <url type="website">https://github.com/RobotnikAutomation/ar_track_alvar</url>
  <author email="sniekum@cs.umass.edu">Scott Niekum</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>pcl_conversions</depend>
  <depend>perception_pcl</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>resource_retriever</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tinyxml2</depend>
  <depend>visualization_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>tinyxml_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
